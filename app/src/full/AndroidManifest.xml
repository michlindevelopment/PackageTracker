<?xml version="1.0" encoding="utf-8"?>
<!--
  SMS access lives only in the `full` flavor. The `nosms` flavor has no
  manifest of its own, so READ_SMS never reaches its merged manifest and the
  build cannot request the permission at all.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_SMS" />

</manifest>
